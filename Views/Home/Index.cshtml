@model HomeVm
@{
    ViewData["Title"] = "Dashboard"; bool auth = User.Identity.IsAuthenticated; bool cust = User.IsInRole("Customer");
    string role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    string first = (User.Identity.Name ?? "").Split(' ')[0];
    var icons = new Dictionary<string, (string Icon, string Color)> {
        ["Awaiting feasibility"] = ("hourglass-split", "amber"), ["Ready to connect"] = ("plug", "cyan"), ["Active connections"] = ("hdd-network", "green"),
        ["Inactive connections"] = ("pause-circle", "red"), ["Customers"] = ("people", "indigo"), ["Bills with dues"] = ("receipt", "violet"),
        ["My orders"] = ("bag-check", "indigo"), ["My connections"] = ("hdd-network", "green") };
    int maxStatus = Model.StatusCounts.Count == 0 ? 1 : Math.Max(1, Model.StatusCounts.Values.Max());
}

@if (!auth)
{
  <div class="hero mb-4">
    <div class="row align-items-center"><div class="col-lg-8">
      <span class="badge bg-light mb-3">Telecom &amp; Internet</span>
      <h2 class="mb-2">Connect your home or business with Nexus</h2>
      <p class="lead mb-4 opacity-75">Dial-up, broadband and landline connections ordered at your nearest retail shop. Track every order and bill in one place.</p>
      <a class="btn btn-light btn-lg me-2" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Create account</a>
      <a class="btn btn-outline-light btn-lg" asp-action="Plans"><i class="bi bi-tags me-1"></i>See plans</a>
    </div></div>
  </div>
  <div class="row g-3">
    <div class="col-md-4"><a class="action-tile" asp-action="Plans"><span class="stat ico-indigo ico" style="width:46px;height:46px;border-radius:12px;display:grid;place-items:center;padding:0"><i class="bi bi-tags fs-4"></i></span><div><b>Plans &amp; charges</b><span>Dial-up, broadband and landline rates</span></div></a></div>
    <div class="col-md-4"><a class="action-tile" asp-action="Search"><span class="ico-cyan" style="width:46px;height:46px;border-radius:12px;display:grid;place-items:center"><i class="bi bi-geo-alt fs-4"></i></span><div><b>Track an order</b><span>Use your order ID or account ID</span></div></a></div>
    <div class="col-md-4"><a class="action-tile" asp-controller="Account" asp-action="Login"><span class="ico-green" style="width:46px;height:46px;border-radius:12px;display:grid;place-items:center"><i class="bi bi-box-arrow-in-right fs-4"></i></span><div><b>Sign in</b><span>Staff and customers</span></div></a></div>
  </div>
}
else
{
  <div class="page-head">
    <div><h3>Welcome back, @first</h3><div class="sub">@(cust ? "Here is a summary of your Nexus account." : "Here is what is happening across Nexus today.") &middot; @DateTime.Now.ToString("dddd, d MMMM yyyy")</div></div>
    <div class="d-flex gap-2">
      @if (cust || User.IsInRole("Retail")) { <a class="btn btn-primary" asp-controller="Orders" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New order</a> }
      @if (User.IsInRole("Accounts")) { <a class="btn btn-primary" asp-controller="Bills" asp-action="Generate"><i class="bi bi-calculator me-1"></i>Generate bill</a> }
      @if (User.IsInRole("Technical")) { <a class="btn btn-primary" asp-controller="Orders" asp-action="Index" asp-route-status="Received"><i class="bi bi-clipboard-check me-1"></i>Orders to check</a> }
      @if (User.IsInRole("Admin")) { <a class="btn btn-primary" asp-controller="Purchases" asp-action="Create"><i class="bi bi-cart-plus me-1"></i>Purchase order</a> }
    </div>
  </div>

  <div class="row g-3 mb-3">
    @foreach (var kv in Model.Counts)
    {
      var ic = icons.TryGetValue(kv.Key, out var v) ? v : ("circle", "indigo");
      <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="ico ico-@ic.Item2"><i class="bi bi-@ic.Item1"></i></div><div><div class="num">@kv.Value</div><div class="lbl">@kv.Key</div></div></div></div></div>
    }
    @if (cust)
    {
      <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="ico ico-red"><i class="bi bi-cash-stack"></i></div><div><div class="num">@Model.TotalDue.ToString("C0")</div><div class="lbl">Amount due</div></div></div></div></div>
      <div class="col-6 col-xl-3"><a class="stat-link" asp-controller="Notifications" asp-action="Index"><div class="card"><div class="stat"><div class="ico ico-amber"><i class="bi bi-bell"></i></div><div><div class="num">@Model.Unread</div><div class="lbl">New notifications</div></div></div></div></a></div>
    }
    else
    {
      <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="ico ico-red"><i class="bi bi-cash-stack"></i></div><div><div class="num">@Model.TotalDue.ToString("C0")</div><div class="lbl">Outstanding</div></div></div></div></div>
      <div class="col-6 col-xl-3"><div class="card"><div class="stat"><div class="ico ico-green"><i class="bi bi-wallet2"></i></div><div><div class="num">@Model.Collected.ToString("C0")</div><div class="lbl">Collected</div></div></div></div></div>
    }
  </div>

  <div class="row g-3">
    <div class="col-xl-7">
      <div class="card h-100"><div class="card-header d-flex justify-content-between align-items-center">Recent orders <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">View all</a></div>
        @if (Model.RecentOrders.Any())
        {
          <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Order</th><th>Customer</th><th>Plan</th><th>Status</th></tr></thead>
          @foreach (var o in Model.RecentOrders)
          {
            <tr style="cursor:pointer" onclick="location='@Url.Action("Details", "Orders", new { id = o.Id })'"><td class="id-mono">@o.OrderNo</td><td>@o.Customer.Name</td><td class="text-muted">@o.Plan.Name</td><td><span class="badge @UI.Css(o.Status.ToString())">@o.Status</span></td></tr>
          }</table></div>
        }
        else { <div class="empty-state"><i class="bi bi-inbox"></i>No orders yet.</div> }
      </div>
    </div>
    <div class="col-xl-5">
      @if (!cust)
      {
        <div class="card mb-3"><div class="card-header">Orders by status</div><div class="card-body">
          @foreach (var kv in Model.StatusCounts)
          {
            <div class="bar-row"><div class="name">@kv.Key</div><div class="track"><div class="fill" data-w="@((kv.Value * 100 / maxStatus))%"></div></div><div class="val">@kv.Value</div></div>
          }
        </div></div>
      }
      <div class="card"><div class="card-header d-flex justify-content-between align-items-center">@(cust ? "Bills to pay" : "Oldest unpaid bills") <a class="btn btn-sm btn-outline-primary" asp-controller="Bills" asp-action="Index" asp-route-dueOnly="true">View</a></div>
        @if (Model.DueBills.Any())
        {
          <div class="list-group list-group-flush">
          @foreach (var b in Model.DueBills)
          {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-controller="Bills" asp-action="Details" asp-route-id="@b.Id">
              <div><span class="id-mono">@b.BillNo</span><div class="small text-muted">@b.Connection.AccountId @(b.DueDate < DateTime.Today ? "· overdue" : "· due " + b.DueDate.ToString("d MMM"))</div></div>
              <b class="@(b.DueDate < DateTime.Today ? "text-danger" : "")">@b.Due.ToString("C")</b></a>
          }</div>
        }
        else { <div class="empty-state"><i class="bi bi-check2-circle"></i>Nothing is overdue.</div> }
      </div>
    </div>
  </div>
}
