@model ChargeSettings
@{ ViewData["Title"] = "Charge settings"; }
<h3>Deposits, tax and billing settings</h3>
<form method="post" class="form-grid card card-body">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Security deposit - Dial-up ($)</label><input type="number" step="0.01" name="DepositDialUp" value="@Model.DepositDialUp.ToString("0.##")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Security deposit - Broadband ($)</label><input type="number" step="0.01" name="DepositBroadband" value="@Model.DepositBroadband.ToString("0.##")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Security deposit - Landline ($)</label><input type="number" step="0.01" name="DepositLandline" value="@Model.DepositLandline.ToString("0.##")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Service tax (%)</label><input type="number" step="0.01" name="TaxPercent" value="@Model.TaxPercent.ToString("0.##")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Max feasible distance (km)</label><input type="number" step="0.1" name="MaxDistanceKm" value="@Model.MaxDistanceKm.ToString("0.##")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Bill payment period (days)</label><input type="number" name="PaymentDays" value="@Model.PaymentDays" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Days after due date before auto-suspension</label><input type="number" name="GraceDays" value="@Model.GraceDays" class="form-control" /></div>
  </div>
  <div class="mt-3"><button class="btn btn-primary">Save</button></div>
</form>
<div class="card card-body mt-3 form-grid">
  <b>Bulk / corporate discount (on advance rental and security deposit)</b>
  <table class="table table-sm mb-0"><tr><th>Connections in one order</th><th>Discount</th></tr><tr><td>10 - 15</td><td>25%</td></tr><tr><td>16 - 25</td><td>50%</td></tr><tr><td>26 - 50</td><td>75%</td></tr><tr><td>above 50</td><td>100%</td></tr></table>
</div>
