@{ ViewData["Title"] = "Generate bill"; var conns = (List<Connection>)ViewBag.Connections; int? sel = ViewBag.Selected; }
<h3>Generate bill (accounts department)</h3>
<p class="text-muted">Rental, security deposit (first bill), call charges (landline), replacement charges, bulk discount and 12.24% service tax are calculated automatically from the plan and equipment. Unpaid earlier bills are carried forward.</p>
<form method="post" class="form-grid card card-body">
  <div class="row g-3">
    <div class="col-12"><label class="form-label">Connection</label><select name="connectionId" class="form-select">@foreach (var c in conns) { <option value="@c.Id" selected="@(sel == c.Id)">@c.AccountId - @c.Customer.Name - @c.Plan.Name (@c.Status)</option> }</select></div>
    <div class="col-md-6"><label class="form-label">Billing period start</label><input type="date" name="periodStart" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Other charges ($)</label><input type="number" step="0.01" name="extra" value="0" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">Local call minutes</label><input type="number" name="local" value="0" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">STD minutes</label><input type="number" name="std" value="0" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">Mobile messaging minutes</label><input type="number" name="sms" value="0" class="form-control" /></div>
  </div>
  <div class="mt-3"><button class="btn btn-primary">Generate bill</button></div>
</form>
