@model List<Payment>
@{ ViewData["Title"] = "Payments"; }
<h3>Payments received</h3>
<div class="card"><div class="table-responsive"><table class="table table-striped mb-0">
<thead><tr><th>Receipt</th><th>Date</th><th>Account ID</th><th>Customer</th><th>Bill</th><th>Mode</th><th>Amount</th></tr></thead>
@foreach (var p in Model) { <tr><td class="id-mono">@p.ReceiptNo</td><td>@p.PaidOn.ToString("yyyy-MM-dd HH:mm")</td><td class="id-mono">@p.Bill.Connection.AccountId</td><td>@p.Bill.Connection.Customer.Name</td><td><a asp-action="Details" asp-route-id="@p.BillId">@p.Bill.BillNo</a></td><td>@p.Mode</td><td>@p.Amount.ToString("C")</td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-muted">No payments.</td></tr> }
</table></div></div>
