@model Customer
@{ ViewData["Title"] = "Register"; var cities = (List<City>)ViewBag.Cities; }
<div class="row justify-content-center"><div class="col-md-6"><div class="card card-body">
<h3>Customer registration</h3>
<partial name="_Errors" />
<form method="post">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Full name</label><input name="Name" value="@Model.Name" class="form-control" required /></div>
    <div class="col-md-6"><label class="form-label">Contact number</label><input name="Phone" value="@Model.Phone" class="form-control" required /></div>
    <div class="col-md-6"><label class="form-label">Email</label><input name="Email" value="@Model.Email" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">City</label><select name="CityId" class="form-select">@foreach (var c in cities) { <option value="@c.Id">@c.Name (@c.Code)</option> }</select></div>
    <div class="col-12"><label class="form-label">Address</label><input name="Address" value="@Model.Address" class="form-control" /></div>
    <div class="col-md-6"><div class="form-check"><input type="checkbox" class="form-check-input" name="IsCorporate" value="true" /><input type="hidden" name="IsCorporate" value="false" /><label class="form-check-label">Corporate / bulk customer</label></div></div>
    <div class="col-md-6"><input name="CompanyName" class="form-control" placeholder="Company name (if corporate)" /></div>
    <div class="col-md-6"><label class="form-label">Username</label><input name="username" class="form-control" required /></div>
    <div class="col-md-6"><label class="form-label">Password</label><input type="password" name="password" class="form-control" required /></div>
  </div>
  <button class="btn btn-primary mt-3">Create account</button>
</form></div></div></div>
