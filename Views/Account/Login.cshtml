@{ ViewData["Title"] = "Sign in"; }
<div class="auth-wrap">
  <div class="auth-hero">
    <div class="brand-mark mb-4" style="width:54px;height:54px;font-size:1.6rem;border-radius:16px"><i class="bi bi-broadcast-pin"></i></div>
    <h2 class="fw-bold">Nexus Service<br />Marketing System</h2>
    <p class="opacity-75 mt-2">One place for orders, connections, billing and payments.</p>
    <ul>
      <li><i class="bi bi-check-circle-fill"></i>Track any order or account by its unique ID</li>
      <li><i class="bi bi-check-circle-fill"></i>Feasibility, connection and bill in one workflow</li>
      <li><i class="bi bi-check-circle-fill"></i>Separate workspaces for each role</li>
    </ul>
  </div>
  <div class="auth-form">
    <h3 class="mb-1">Welcome back</h3>
    <p class="text-muted mb-4">Sign in to continue to your workspace.</p>
    @if (ViewBag.Error != null) { <div class="alert alert-danger d-flex align-items-center"><i class="bi bi-exclamation-octagon me-2"></i>@ViewBag.Error</div> }
    <form method="post">
      <input type="hidden" name="returnUrl" value="@ViewBag.Return" />
      <div class="mb-3"><label class="form-label">Username</label><input name="username" class="form-control form-control-lg" autofocus autocomplete="username" /></div>
      <div class="mb-3"><label class="form-label">Password</label><input type="password" name="password" class="form-control form-control-lg" autocomplete="current-password" /></div>
      <button class="btn btn-primary btn-lg w-100 mb-3">Sign in</button>
      <div class="text-center text-muted">New customer? <a asp-action="Register">Create an account</a></div>
    </form>
    <hr class="my-4" />
    <div class="small text-muted mb-2">Demo accounts - click to fill</div>
    <div class="d-flex flex-wrap gap-2">
      <span class="demo-chip" data-demo="admin|Admin@123"><i class="bi bi-shield-lock me-1"></i>Admin</span>
      <span class="demo-chip" data-demo="retail1|Retail@123"><i class="bi bi-shop me-1"></i>Retail</span>
      <span class="demo-chip" data-demo="tech1|Tech@123"><i class="bi bi-tools me-1"></i>Technical</span>
      <span class="demo-chip" data-demo="acc1|Acc@123"><i class="bi bi-calculator me-1"></i>Accounts</span>
      <span class="demo-chip" data-demo="cust1|Cust@123"><i class="bi bi-person me-1"></i>Customer</span>
      <span class="demo-chip" data-demo="acme|Cust@123"><i class="bi bi-building me-1"></i>Corporate</span>
    </div>
  </div>
</div>
