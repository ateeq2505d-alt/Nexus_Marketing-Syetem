@model Customer
@{ ViewData["Title"] = "Edit customer"; var cities = (List<City>)ViewBag.Cities; }
<h3>Edit customer contact details</h3>
<form method="post" class="form-grid card card-body">
  <div class="mb-3"><label class="form-label">Name</label><input name="name" value="@Model.Name" class="form-control" required /></div>
  <div class="mb-3"><label class="form-label">Contact number</label><input name="phone" value="@Model.Phone" class="form-control" required /></div>
  <div class="mb-3"><label class="form-label">Email</label><input name="email" value="@Model.Email" class="form-control" /></div>
  <div class="mb-3"><label class="form-label">Address</label><input name="address" value="@Model.Address" class="form-control" /></div>
  <div class="mb-3"><label class="form-label">City</label><select name="cityId" class="form-select">@foreach (var c in cities) { <option value="@c.Id" selected="@(c.Id == Model.CityId)">@c.Name (@c.Code)</option> }</select></div>
  <div class="form-check mb-2"><input type="checkbox" class="form-check-input" name="isCorporate" value="true" checked="@Model.IsCorporate" /><input type="hidden" name="isCorporate" value="false" /><label class="form-check-label">Corporate / bulk customer</label></div>
  <div class="mb-3"><label class="form-label">Company name</label><input name="companyName" value="@Model.CompanyName" class="form-control" /></div>
  <div><button class="btn btn-primary">Save</button> <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
</form>
