@model List<Order>
@{ ViewData["Title"] = "Orders"; string st = ViewBag.Status; }
<div class="d-flex justify-content-between align-items-center mb-2">
  <h3>Orders</h3>
  @if (User.IsInRole("Retail") || User.IsInRole("Customer")) { <a class="btn btn-primary" asp-action="Create">+ Place new order</a> }
</div>
<div class="mb-2">
  <a class="btn btn-sm @(st == null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">All</a>
  @foreach (var s in Enum.GetNames<OrderStatus>()) { <a class="btn btn-sm @(st == s ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@s">@s</a> }
</div>
<div class="card"><div class="table-responsive"><table class="table table-striped table-hover mb-0">
<thead><tr><th>Order ID</th><th>Customer</th><th>Type</th><th>Plan</th><th>Qty</th><th>Shop</th><th>Applied</th><th>Status</th><th></th></tr></thead>
@foreach (var o in Model)
{
  <tr><td class="id-mono">@o.OrderNo</td><td>@o.Customer.Name</td><td>@o.ConnType</td><td>@o.Plan.Name</td><td>@o.Quantity</td><td>@o.Shop?.Name</td><td>@o.ApplicationDate.ToString("yyyy-MM-dd")</td>
  <td><span class="badge @UI.Css(o.Status.ToString())">@o.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.Id">Open</a></td></tr>
}
@if (!Model.Any()) { <tr><td colspan="9" class="text-muted">No orders.</td></tr> }
</table></div></div>
