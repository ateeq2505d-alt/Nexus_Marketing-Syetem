@using System.Reflection
@model CrudFormVm
@{ ViewData["Title"] = Model.Title; }
<h3>@Model.Title</h3>
<form method="post" class="form-grid card card-body">
  <partial name="_Errors" />
  @foreach (var p in Model.Props)
  {
    var label = p.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>()?.DisplayName ?? p.Name;
    var val = p.GetValue(Model.Model);
    var ut = Nullable.GetUnderlyingType(p.PropertyType) ?? p.PropertyType;
    <div class="mb-3">
    @if (ut == typeof(bool))
    {
        <div class="form-check"><input type="checkbox" class="form-check-input" name="@p.Name" value="true" @(val is true ? "checked" : "") /><input type="hidden" name="@p.Name" value="false" /><label class="form-check-label">@label</label></div>
    }
    else
    {
        <label class="form-label">@label</label>
        @if (Model.Lookups.TryGetValue(p.Name, out var lk))
        {
            <select name="@p.Name" class="form-select">
              @if (Nullable.GetUnderlyingType(p.PropertyType) != null) { <option value="">(none)</option> }
              @foreach (var kv in lk) { <option value="@kv.Key" selected="@(val is int vi && vi == kv.Key)">@kv.Value</option> }
            </select>
        }
        else if (ut.IsEnum)
        {
            <select name="@p.Name" class="form-select">@foreach (var n in Enum.GetNames(ut)) { <option value="@n" selected="@(val?.ToString() == n)">@n</option> }</select>
        }
        else if (p.GetCustomAttribute<System.ComponentModel.DataAnnotations.DataTypeAttribute>()?.DataType == System.ComponentModel.DataAnnotations.DataType.Password)
        { <input type="password" name="@p.Name" class="form-control" autocomplete="new-password" /> }
        else if (ut == typeof(int)) { <input type="number" name="@p.Name" value="@val" class="form-control" /> }
        else if (ut == typeof(decimal)) { <input type="number" step="0.01" name="@p.Name" value="@(val is decimal dv ? dv.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" class="form-control" /> }
        else if (ut == typeof(DateTime)) { <input type="date" name="@p.Name" value="@(val is DateTime dd ? dd.ToString("yyyy-MM-dd") : "")" class="form-control" /> }
        else { <input name="@p.Name" value="@val" class="form-control" /> }
        @if (ViewData.ModelState.TryGetValue(p.Name, out var ms) && ms.Errors.Count > 0) { <div class="text-danger small">@ms.Errors[0].ErrorMessage</div> }
    }
    </div>
  }
  <div><button class="btn btn-primary">Save</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div>
</form>
