@using System.Reflection
@model CrudIndexVm
@{ ViewData["Title"] = Model.Title; var ctl = (string)ViewContext.RouteData.Values["controller"]; }
<div class="d-flex justify-content-between align-items-center mb-2">
  <h3>@Model.Title</h3>
  @if (Model.CanCreate) { <a class="btn btn-primary" asp-action="Create">+ Add new</a> }
</div>
@if (Model.Hint != null) { <div class="text-muted mb-2">@Model.Hint</div> }
<form method="get" class="row g-2 mb-3"><div class="col-auto"><input name="q" value="@Model.Q" class="form-control" placeholder="Search..." /></div>
  <div class="col-auto"><button class="btn btn-outline-primary">Search</button> <a class="btn btn-link" asp-action="Index">Clear</a></div></form>
<div class="card"><div class="table-responsive"><table class="table table-striped table-hover mb-0">
<thead><tr>@foreach (var p in Model.Props) { var dn = p.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>()?.DisplayName ?? p.Name; <th>@dn</th> }<th></th></tr></thead>
<tbody>
@foreach (var o in Model.Items)
{
    var id = (int)o.GetType().GetProperty("Id").GetValue(o);
    <tr>
    @foreach (var p in Model.Props)
    {
        var v = p.GetValue(o); string t = v?.ToString() ?? "";
        if (v is int i && Model.Lookups.TryGetValue(p.Name, out var d)) { t = d.GetValueOrDefault(i, i.ToString()); }
        else if (v is bool b) { t = b ? "Yes" : "No"; }
        else if (v is DateTime dt) { t = dt.ToString("yyyy-MM-dd"); }
        else if (v is decimal m) { t = m.ToString("0.##"); }
        if (t.Length > 60) { t = t.Substring(0, 60) + "..."; }
        <td>@t</td>
    }
    <td class="text-end text-nowrap">
      @foreach (var a in Model.Actions) { <form method="post" asp-action="@a.Action" asp-route-id="@id" class="d-inline"><button class="btn btn-sm @a.Css">@a.Label</button></form> }
      <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@id">Edit</a>
      <form method="post" asp-action="Delete" asp-route-id="@id" class="d-inline" data-confirm="Delete this record?"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
    </td></tr>
}
</tbody></table></div></div>
